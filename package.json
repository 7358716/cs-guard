{
  "name": "cs-guard",
  "version": "1.8.0",
  "type": "module",
  "description": "cs-guard \u2014 \u770b\u62a4/\u5b88\u62a4\uff1a\u7f51\u7edc / \u73af\u5883 / \u914d\u7f6e / \u5d29\u6e83 / \u5bf9\u8bdd\u4e2d\u65ad \u4e94\u7c7b\u6545\u969c\u7684\u68c0\u6d4b\u4e0e\u6062\u590d",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compat": {
      "tested": [
        ">=0.2.1-rc.2"
      ],
      "note": "\u5bbf\u4e3b rc1 \u4e5f\u80fd\u52a0\u8f7d\uff08\u5bbf\u4e3b\u673a\u517c\u5bb9\u5c42 + \u5ba2\u6237\u7aef\u9632\u5fa1\u5f0f\u6ce8\u518c\uff09"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:static": "bash test/ci-static.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7358716/cs-guard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}