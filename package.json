{
  "name": "cs-guard",
  "version": "1.4.1",
  "type": "module",
  "description": "cs-guard — 看护/守护：网络 / 环境 / 配置 / 崩溃 / 对话中断 五类故障的检测与恢复",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "presets.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compat": {
      "tested": [
        ">=0.2.1-rc.2"
      ],
      "note": "宿主 rc1 也能加载（宿主机兼容层 + 客户端防御式注册）"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:static": "bash test/ci-static.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7358716/cs-guard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
